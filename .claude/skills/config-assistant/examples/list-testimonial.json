{
  "feature": "list-testimonial",
  "titre": "Section liste de témoignages (presenter testimonial)",
  "description": "searchProStatic avec list.card/preview type testimonial (design bubble) — le presenter lit sa tranche list.testimonial.",
  "source": "config.prod.parent62.json",
  "selector": "pages[path=/temoignages].sections[id=paroles-grid].props.rightSection",
  "snapshot": {
    "type": "searchProStatic",
    "id": "paroles-list",
    "props": {
      "customHeader": {
        "title": {
          "fr": "Toutes les paroles",
          "en": "All testimonies"
        }
      },
      "useFilter": true,
      "showMap": false,
      "enableMap": true,
      "baseParams": {
        "defaultTypes": [
          "poi"
        ],
        "sourceKey": [
          "parent62"
        ],
        "defaultFilters": {
          "type": "affiche"
        },
        "defaultFields": [
          "name",
          "slug",
          "category",
          "description",
          "medias",
          "profilImageUrl",
          "profilMediumImageUrl",
          "address",
          "geo",
          "geoPosition",
          "territoires",
          "publics",
          "ages",
          "themes",
          "tags",
          "created",
          "type",
          "source"
        ],
        "searchBy": [
          "name",
          "description"
        ],
        "defaultSortBy": {
          "created": -1
        }
      },
      "map": {
        "layout": "split",
        "cluster": true,
        "itemAction": {
          "kind": "preview"
        },
        "marker": {
          "style": "pin",
          "colorBy": {
            "path": "territoires",
            "mapping": {
              "Arrageois": "var(--territoire-arrageois)",
              "Artois": "var(--territoire-artois)",
              "Audomarois": "var(--territoire-audomarois)",
              "Boulonnais": "var(--territoire-boulonnais)",
              "Calaisis": "var(--territoire-calaisis)",
              "Entre Mer et Terres": "var(--territoire-entre-mer-et-terres)",
              "Familles en sol mineur Hénin Carvin": "var(--territoire-fsm-henin-carvin)",
              "Familles en sol mineur Lens Liévin": "var(--territoire-fsm-lens-lievin)",
              "Ternois Bruaysis": "var(--territoire-ternois-bruaysis)"
            }
          }
        }
      },
      "list": {
        "columns": {
          "sm": 1,
          "md": 2,
          "lg": 3
        },
        "card": {
          "type": "testimonial",
          "detailsMode": "dialog"
        },
        "preview": {
          "type": "testimonial",
          "width": "2xl"
        },
        "testimonial": {
          "design": "bubble",
          "quoteField": "description",
          "titleField": "name",
          "dateField": "created",
          "audioField": "medias",
          "subtitleField": "themes",
          "badge": {
            "field": "category"
          },
          "accent": {
            "field": "territoires",
            "colors": {
              "Arrageois": "var(--territoire-arrageois)",
              "Artois": "var(--territoire-artois)",
              "Audomarois": "var(--territoire-audomarois)",
              "Boulonnais": "var(--territoire-boulonnais)",
              "Calaisis": "var(--territoire-calaisis)",
              "Entre Mer et Terres": "var(--territoire-entre-mer-et-terres)",
              "Familles en sol mineur Hénin Carvin": "var(--territoire-fsm-henin-carvin)",
              "Familles en sol mineur Lens Liévin": "var(--territoire-fsm-lens-lievin)",
              "Ternois Bruaysis": "var(--territoire-ternois-bruaysis)"
            }
          },
          "facets": [
            {
              "field": "territoires",
              "label": {
                "fr": "Territoires",
                "en": "Territories"
              }
            },
            {
              "field": "publics",
              "label": {
                "fr": "Publics",
                "en": "Audiences"
              }
            },
            {
              "field": "ages",
              "label": {
                "fr": "Âges",
                "en": "Ages"
              }
            },
            {
              "field": "themes",
              "label": {
                "fr": "Thèmes",
                "en": "Themes"
              }
            },
            {
              "field": "tags",
              "label": {
                "fr": "Mots-clés",
                "en": "Keywords"
              }
            }
          ]
        }
      },
      "showActiveFiltersTags": true
    }
  }
}
