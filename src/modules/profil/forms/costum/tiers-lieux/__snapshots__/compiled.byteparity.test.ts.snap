exports[`tiers-lieu — byte-parité structurelle (descriptor + spec) > spec figée (snapshot) 1`] = `
{
  "defaults": {
    "base": "tl:emptyDefaults",
  },
  "descriptor": {
    "ref": "tiers-lieux",
  },
  "dialogClassName": "sm:max-w-[820px] h-[92vh] flex flex-col p-0 gap-0 overflow-hidden",
  "gradientHeader": true,
  "icon": "building-2",
  "id": "tiers-lieux",
  "image": {
    "existingUrlFrom": "image:profilUrl",
    "field": "_logoFile",
  },
  "mutation": {
    "entityType": "organizations",
    "errorContext": {
      "add": "EntityFormModal · ADD_TIERSLIEU",
      "edit": "EntityFormModal · EDIT_TIERSLIEU",
    },
    "errorKey": {
      "add": "AddTiersLieux.toast.error",
      "edit": "EditTiersLieux.toast.error",
    },
    "inject": {
      "extraFields": {
        "preferences": {
          "isOpenData": true,
          "isOpenEdition": true,
        },
        "type": "NGO",
      },
    },
    "invalidateFn": {
      "fn": "invalidate:standard",
      "params": {
        "userList": "organizations",
      },
    },
    "payloadEmitEmptyOnEdit": true,
    "payloadFn": "tl:payload",
    "successKey": {
      "add": "AddTiersLieux.toast.success",
      "edit": "EditTiersLieux.toast.success",
    },
  },
  "navText": {
    "cancel": {
      "en": "Cancel",
      "fr": "Annuler",
    },
    "next": {
      "en": "Next →",
      "fr": "Suivant →",
    },
    "previous": {
      "en": "← Previous",
      "fr": "← Précédent",
    },
    "stepTemplate": {
      "ofKey": {
        "en": "of",
        "fr": "sur",
      },
      "stepKey": {
        "en": "Step",
        "fr": "Étape",
      },
    },
  },
  "scope": {
    "derive": "tl:scope",
    "slugFrom": "derived",
    "slugKey": "slug",
  },
  "submitLabel": {
    "add": {
      "en": "Create the third-place",
      "fr": "Créer le tiers-lieu",
    },
    "edit": {
      "en": "Save changes",
      "fr": "Enregistrer les modifications",
    },
  },
  "title": {
    "add": {
      "en": "Create your third-place",
      "fr": "Créer votre tiers-lieu",
    },
    "edit": {
      "en": "Edit your third-place",
      "fr": "Modifier votre tiers-lieu",
    },
  },
  "validationFailedKey": {
    "en": "Please fix the highlighted fields (see the flagged tabs).",
    "fr": "Veuillez corriger les champs en erreur (voir les onglets signalés).",
  },
}
`;
