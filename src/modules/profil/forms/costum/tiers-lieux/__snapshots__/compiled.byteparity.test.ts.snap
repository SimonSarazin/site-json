        "otherField": "familyOther",
        "readOtherFrom": "typePlaceOther",
        "separator": ", ",
      },
      "read": "multiCsv:read",
      "serverKey": "typePlace",
      "write": "multiCsv:write",
    },
  },
  "validate": "addressComplete",
}
