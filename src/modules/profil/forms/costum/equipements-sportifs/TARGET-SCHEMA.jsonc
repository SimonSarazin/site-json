// ════════════════════════════════════════════════════════════════════════════════════════════════════════
// SCHÉMA CIBLE — costum « équipements sportifs » (POI SSBE / equipementsSportifs974)
// ────────────────────────────────────────────────────────────────────────────────────────────────────────
// Objectif : décrire l'entité ENTIÈREMENT en DONNÉES, avec CHAQUE NOM DE CHAMP déclaré UNE SEULE FOIS (dans
// `fields`). Tout le reste est DÉRIVÉ à l'exécution (pas de re-listage des champs) :
//   • defaults   ← dérivés du `widget`/`type` (string→"", number→undefined, bool→false, array→[]) sauf override.
//   • validation ← dérivée de `widget`/`type`/`rules`/`required`.
//   • read/write ← coercition par type + CODECS DE GROUPE COMMUNS (`address`/`openingHours`/`social`/`geo`),
//                  partagés par toutes les entités (plus de `poi:addressRead` propre).
//   • type TS    ← générique `FormValues` (plus de `AddPoiFormData`).
//   • projection recherche (doublons) ← dérivée des `fields` (+ extras image/parent), côté recherche.
// → un champ n'apparaît plus que 2 fois : sa DÉCLARATION (`fields`) et son PLACEMENT (`sections`).
//
// CE QUI RESTE PAR CLÉ (code irréductible enregistré, pas du JSON) :
//   • COMMUN (partagé) : codecs de groupe `address`/`openingHours`/`social`/`geo:write`, compute `multiply`,
//     coercions `coerce:*`, moteur de mutation, résolveur de scope.
//   • PROPRE au costum : slots `parentInfo`/`poiDoublons` (UI React), `poi:scope` (dérive parentId/sourceKey
//     du carrier), `poi:dropEmptyUrls`, `poi:invalidate`, `image:profilUrl`.
//
// NB : NON BRANCHÉ — artefact de discussion/cible. Le moteur ne lit pas encore ce fichier.
// ════════════════════════════════════════════════════════════════════════════════════════════════════════
{
  "id": "equipements-sportifs",
  "entityType": "poi",

  // ── i18n : mode `localized` (LocalizedString {fr,en} inline, comme la config globale) — config
  // auto-suffisante, par-déploiement. (Le costum actuel est en mode `keys` car ses libellés vivent dans
  // l'i18n de l'app `profil/i18n/*.json` — centralisé/DRY ; le schéma supporte les DEUX via `Label = LocalizedString | string`.)
  // DÉFAUT POUR LE COMMUN : un champ STANDARD (name/adresse/image/geo/description/tags) n'a PAS de `label`
  // → le moteur fournit le libellé standard par défaut. Seuls les champs SPÉCIFIQUES au costum déclarent le leur.
  "i18n": "localized",

  // ── Identité costum (DONNÉE de config) ───────────────────────────────────────────────────────────────
  // parentId/sourceKey surchargés par le carrier live (poi:scope) ; poiType/addressCountry = constantes 974.
  "costum": {
    "derive": "poi:scope",                 // clé : carrier ⊕ defaults → scope résolu
    "slug": { "from": "scope", "key": "sourceKey" },
    "defaults": {
      "parentId": "6a04155ed047177b92399685",
      "sourceKey": "equipementsSportifs974",
      "poiType": "recoveryCenter",
      "addressCountry": "RE"
    }
  },

  // ── STAMP : valeurs fixes tamponnées au CREATE (édition n'y touche pas) ───────────────────────────────
  "stamp": { "fromScope": { "type": "poiType" } },   // payload.type = scope.poiType (single-source)

  // ── Chrome / wizard ──────────────────────────────────────────────────────────────────────────────────
  "chrome": {
    "title": { "add": "AddPoiEquipement.title.add", "edit": "AddPoiEquipement.title.edit" },
    "description": { "add": "AddPoiEquipement.description.add", "edit": "AddPoiEquipement.description.edit" },
    "submitLabel": { "add": "AddEntity.create", "edit": "ProfileEdit.save" },
    "dialogClassName": "sm:max-w-[820px] h-[92vh] flex flex-col p-0 gap-0 overflow-hidden",
    "validationFailedKey": "AddPoiEquipement.validationFailed",
    "navText": {
      "next": "AddPoiEquipement.buttons.next",
      "previous": "AddPoiEquipement.buttons.previous",
      "cancel": "common.cancel",
      "stepLabelKey": "AddPoiEquipement.stepIndicator"
    }
  },
  "layout": { "kind": "wizard", "validatePerStep": true },
  "listsFromCarrier": true,
  "image": { "field": "_imageFile", "existingUrlFrom": "image:profilUrl" },
  "slots": { "parentInfo": "parentInfo", "doublons": "poiDoublons" },
  "cleanValues": "poi:dropEmptyUrls",

  // ── WRITE / mutation (DONNÉES + clés) ────────────────────────────────────────────────────────────────
  // payload : pipeline (défaut) ; emitEmpty en édition. inject.parent depuis le ctx. successKey/errorKey/
  // errorContext varient add≠edit. invalidate = clé (poi:invalidate).
  "mutation": {
    "payloadEmitEmptyOnEdit": true,
    "inject": { "parent": true },
    "navigateOnSuccess": false,
    "successKey": { "add": "toast.add.poiSuccess", "edit": "toast.profile.updateSuccess" },
    "errorKey": { "add": "toast.add.poiError", "edit": "toast.profile.updateError" },
    "errorContext": { "add": "EntityFormModal · ADD_POI", "edit": "EntityFormModal · UPDATE_POI" },
    "invalidateFn": "poi:invalidate"
  },

  // ── Groupes de sérialisation : codecs COMMUNS (objet serveur ↔ champs plats) ──────────────────────────
  // `address` partagé par toutes les entités (round-trip 14 clés SIG + pays défaut via le socle/scope).
  "serializeGroups": {
    "address": { "serverKey": "address", "codec": "group:address" }
  },

  // ── Layout : ordre / colonnes / sous-blocs conditionnels (référence les noms, ne les définit pas) ─────
  "sections": [
    { "id": "general", "label": "AddPoiEquipement.steps.general", "groups": [
      { "columns": 1, "fields": ["$slot:parentInfo", "name"] },
      { "columns": 2, "fields": ["equip_type_name", "equip_type_famille"] },
      { "columns": 1, "fields": ["_imageFile"] },
      { "columns": 1, "label": "AddPoiEquipement.fields.address", "required": true,
        "fields": ["address", "addressCountry", "addressLocality", "postalCode", "streetAddress"] },
      { "columns": 1, "fields": ["$slot:doublons"] }
    ]},
    { "id": "legal", "label": "AddPoiEquipement.steps.legal", "groups": [
      { "columns": 2, "fields": ["equip_prop_nom", "equip_prop_type"] },
      { "columns": 3, "fields": ["inst_date_creation", "inst_enqu_date", "equip_maj_date"] },
      { "columns": 1, "fields": ["inst_nom", "categorie", "equip_gest_type"] },
      { "columns": 1, "fields": ["inst_part_bool", "inst_part_type"] }
    ]},
    { "id": "structure", "label": "AddPoiEquipement.steps.structure", "groups": [
      { "columns": 2, "fields": ["equip_nature", "equip_sol"] },
      { "columns": 3, "fields": ["equip_long", "equip_larg", "equip_surf"] },
      { "columns": 2, "fields": ["inst_acc_handi_type", "inst_trans_type"] },
      { "columns": 2, "fields": ["inst_acc_handi_bool", "inst_trans_bool", "equip_eclair", "equip_douche"] },
      { "columns": 1, "fields": ["equip_pmr_acc"] },
      { "columns": 2, "label": "AddPoiEquipement.sections.pmr", "visibleIf": { "field": "equip_pmr_acc", "op": "truthy" },
        "fields": ["equip_pmr_chem", "equip_pmr_douche", "equip_pmr_trib", "equip_pmr_vest", "equip_pmr_sanit"] },
      { "columns": 1, "fields": ["equip_loc_type"] },
      { "columns": 2, "label": "AddPoiEquipement.sections.pshs",
        "fields": ["equip_pshs_aire", "equip_pshs_sanit", "equip_pshs_trib", "equip_pshs_sign", "equip_pshs_vest", "equip_pshs_chem"] }
    ]},
    { "id": "usage", "label": "AddPoiEquipement.steps.usage", "groups": [
      { "columns": 1, "fields": ["urls"] },
      { "columns": 1, "fields": ["equip_utilisateur"] },
      { "columns": 1, "fields": ["equip_acc_libre"] },
      { "columns": 1, "fields": ["aps_name"] }
    ]}
  ],

  // ── CHAMPS : déclarés UNE SEULE FOIS. `read`/`default`/`validation` DÉRIVÉS du widget (non répétés). ──
  // widget → (type, read, default) implicites : text→(string, coerce:string, ""), number→(number, coerce:number,
  // undefined), switch→(bool, coerce:bool, false), date→(date, coerce:dateYMD, ""), checkboxGroup/multiselect/
  // tags/urlList→(array, coerce:stringArray, []), selectFromLists→(string, coerce:string, "").
  // LABEL : champ COMMUN → pas de `label` (le moteur fournit le standard) ; champ COSTUM → LocalizedString
  // inline (mode `localized`). {fr} montré ici ; en/… ajoutés de la même façon. placeholders/addLabel idem
  // (laissés en clé pour la lisibilité du squelette).
  "fields": {
    // ── COMMUNS → label PAR DÉFAUT (non déclaré) ──────────────────────────────────────────────────────
    "description": { "widget": "hidden" },
    "tags":        { "widget": "hidden", "type": "array" },
    "geo":         { "widget": "hidden", "writeOnly": true, "write": "geo:write" },
    "geoPosition": { "widget": "hidden", "writeOnly": true, "write": "geoPosition:write" },
    "addressCountry":  { "widget": "hidden", "required": true, "group": "address" },
    "addressLocality": { "widget": "hidden", "required": true, "group": "address" },
    "postalCode":      { "widget": "hidden", "required": true, "group": "address" },
    "streetAddress":   { "widget": "hidden", "required": true, "group": "address" },
    "localityId":      { "widget": "hidden", "group": "address" },
    "address":    { "widget": "location", "renderOnly": true },
    "_imageFile": { "widget": "image", "renderOnly": true },
    "name":       { "widget": "text", "required": true },

    // ── SPÉCIFIQUES au costum → LocalizedString inline ────────────────────────────────────────────────
    "equip_type_name":   { "widget": "selectFromLists", "required": true, "label": { "fr": "Type de l'équipement" } },
    "equip_type_famille":{ "widget": "selectFromLists", "label": { "fr": "Famille d'équipement" } },
    "equip_prop_nom":  { "widget": "text", "label": { "fr": "Nom du propriétaire" } },
    "equip_prop_type": { "widget": "selectFromLists", "label": { "fr": "Type de propriétaire" } },
    "inst_date_creation": { "widget": "date", "label": { "fr": "Date de création" } },
    "inst_enqu_date":  { "widget": "date", "label": { "fr": "Date d'enquête" } },
    "equip_maj_date":  { "widget": "date", "label": { "fr": "Date de mise à jour" } },
    "inst_nom":        { "widget": "text", "label": { "fr": "Nom de l'institution" } },
    "categorie":       { "widget": "text", "label": { "fr": "Catégorie" } },
    "equip_gest_type": { "widget": "text", "label": { "fr": "Type de gestionnaire" } },
    "inst_part_bool":  { "widget": "switch", "label": { "fr": "Partenariat disponible" } },
    "inst_part_type":  { "widget": "tags", "label": { "fr": "Type de partenariat" },
                         "widgetProps": { "searchable": false }, "visibleIf": { "field": "inst_part_bool", "op": "truthy" } },
    "equip_nature": { "widget": "selectFromLists", "label": { "fr": "Nature de l'équipement" } },
    "equip_sol":    { "widget": "selectFromLists", "label": { "fr": "Type de sol" } },
    "equip_long":   { "widget": "number", "label": { "fr": "Longueur" } },
    "equip_larg":   { "widget": "number", "label": { "fr": "Largeur" } },
    "equip_surf":   { "widget": "number", "label": { "fr": "Surface (calculée)" },
                      "compute": { "deps": ["equip_long", "equip_larg"], "fn": "multiply" } },
    "inst_acc_handi_type": { "widget": "text", "label": { "fr": "Type de handicap pris en charge" } },
    "inst_trans_type":     { "widget": "text", "label": { "fr": "Moyen de transport disponible" } },
    "inst_acc_handi_bool": { "widget": "switch", "label": { "fr": "Accessible aux personnes en situation de handicap" } },
    "inst_trans_bool":     { "widget": "switch", "label": { "fr": "Accessible en transport en commun" } },
    "equip_eclair":  { "widget": "switch", "label": { "fr": "Éclairage de l'aire" } },
    "equip_douche":  { "widget": "switch", "label": { "fr": "Douche accessible" } },
    "equip_pmr_acc": { "widget": "switch", "label": { "fr": "Accès PMR disponible" } },
    "equip_pmr_chem":   { "widget": "switch", "label": { "fr": "Cheminement PMR adapté" } },
    "equip_pmr_douche": { "widget": "switch", "label": { "fr": "Douches accessibles PMR" } },
    "equip_pmr_trib":   { "widget": "switch", "label": { "fr": "Tribunes accessibles PMR" } },
    "equip_pmr_vest":   { "widget": "switch", "label": { "fr": "Vestiaires accessibles PMR" } },
    "equip_pmr_sanit":  { "widget": "switch", "label": { "fr": "Sanitaires accessibles PMR" } },
    "equip_loc_type":   { "widget": "checkboxGroup", "label": { "fr": "Locaux complémentaires" } },
    "equip_pshs_aire":  { "widget": "switch", "label": { "fr": "Aire de jeu" } },
    "equip_pshs_sanit": { "widget": "switch", "label": { "fr": "Sanitaires" } },
    "equip_pshs_trib":  { "widget": "switch", "label": { "fr": "Tribunes" } },
    "equip_pshs_sign":  { "widget": "switch", "label": { "fr": "Accueil / Signalétique" } },
    "equip_pshs_vest":  { "widget": "switch", "label": { "fr": "Vestiaires" } },
    "equip_pshs_chem":  { "widget": "switch", "label": { "fr": "Cheminements" } },
    "urls": { "widget": "urlList", "label": { "fr": "Site internet" },
              "widgetProps": { "addLabel": "AddPoiEquipement.buttons.addUrl", "removeLabel": "AddPoiEquipement.buttons.removeUrl" } },
    "equip_utilisateur": { "widget": "checkboxGroup", "label": { "fr": "Types d'utilisateurs" } },
    "equip_acc_libre":   { "widget": "switch", "label": { "fr": "Accès libre" } },
    "aps_name": { "widget": "multiselect", "required": true, "label": { "fr": "Sports pratiqués" },
                  "placeholder": "AddPoiEquipement.placeholders.selectSport", "placeholderSearch": "AddPoiEquipement.placeholders.searchSport" }
  }
}
