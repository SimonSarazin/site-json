{
  "name": "site-forge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server/dev-server.js",
    "typecheck": "tsc -b --noEmit",
    "build:client": "tsc -b && vite build --outDir dist/client",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist/server",
    "build:config": "tsx scripts/generate-config.ts",
    "build": "npm run clean && npm run build:client && npm run build:server",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "lint": "eslint .",
    "preview": "cross-env NODE_ENV=production SITE_CONFIG_PATH=$PWD/config.prod.tiers-lieux.json node server/prod-server.js",
    "preview:ssr": "npm run build:ssr && npm preview",
    "start": "node server/prod-server.js",
    "test": "vitest run",
    "test:unit": "vitest run -c vitest.config.unit.ts",
    "test:integration": "vitest run -c vitest.config.integration.ts",
    "test:e2e": "playwright test",
    "test:preflight": "vitest run -c vitest.config.unit.ts tests/preflight/",
    "audit:config": "tsx scripts/audit-config.ts",
    "test:coverage": "vitest run -c vitest.config.unit.ts --coverage",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:watch": "vitest --watch",
    "config:validate": "tsx scripts/validate-config.ts",
    "config:schema": "tsx scripts/config-schema.ts",
    "entity:slug": "tsx scripts/entity-slug.ts",
    "map:functions": "tsx scripts/map-functions.ts",
    "config:costum": "tsx scripts/gen-costum-config.ts",
    "admin:scaffold": "tsx scripts/admin-scaffold.ts",
    "config:example": "tsx scripts/config-example.ts",
    "config:fix": "tsx scripts/fix-config.ts",
    "config:surface": "node scripts/config-surface.mjs",
    "config:init": "tsx scripts/config-init.ts",
    "config:probe": "tsx scripts/config-probe.ts",
    "config:render": "tsx scripts/config-render.ts",
    "verify:build": "tsx scripts/verify-build.ts",
    "deploy:status": "tsx scripts/deploy.ts status",
    "deploy:lock": "tsx scripts/deploy.ts lock",
    "deploy": "tsx scripts/deploy.ts push",
    "deploy:env": "tsx scripts/deploy.ts env",
    "deploy:rollout": "tsx scripts/deploy.ts rollout",
    "deploy:affected": "tsx scripts/deploy.ts affected",
    "deploy:dns": "tsx scripts/deploy.ts dns",
    "deploy:alias": "tsx scripts/deploy.ts alias",
    "deploy:create": "tsx scripts/deploy.ts create",
    "config:costum-drift": "tsx scripts/costum-form-drift.ts",
    "contract:snapshot": "node scripts/contract-snapshot.mjs",
    "contract:snapshot:live": "node scripts/contract-snapshot-live.mjs",
    "test:costum-forms": "vitest run -c vitest.config.integration.ts tests/integration/costum-forms.e2e.test.ts && E2E_MODE=live vitest run -c vitest.config.integration.ts tests/integration/costum-forms.e2e.test.ts",
    "config:answer-labels": "node scripts/answer-facet-labels.mjs",
    "config:changelog": "node scripts/config-changelog.mjs",
    "config:besoins": "node scripts/config-besoins.mjs"
  },
  "resolutions": {
