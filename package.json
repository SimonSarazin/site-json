{
  "name": "site-forge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server/dev-server.js",
    "build:client": "tsc -b && vite build --outDir dist/client",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist/server",
    "build:config": "tsx scripts/generate-config.ts",
    "build": "npm run clean && npm run build:client && npm run build:server",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "lint": "eslint .",
    "preview": "cross-env NODE_ENV=production SITE_CONFIG_PATH=$PWD/config.prod.json node server/prod-server.js",
    "preview:ssr": "npm run build:ssr && npm preview",
    "start": "node server/prod-server.js"
  },
